{
  "name": "openbot",
  "version": "0.1.0",
  "description": "Bring your own models to Grok Bot. One-line install on the Computer, a local control UI, and an official-mode switch that restores stock chat.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "openbot": "src/cli.ts"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test $(find src -name '*.test.ts')",
    "typecheck": "tsc --noEmit",
    "start": "node --experimental-strip-types src/cli.ts",
    "start:ui": "node --experimental-strip-types src/ui/server.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaravarr/openbot.git"
  },
  "bugs": {
    "url": "https://github.com/aaravarr/openbot/issues"
  },
  "homepage": "https://github.com/aaravarr/openbot#readme",
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
